# ─────────────────────────────────────────────────────────────────────────────
# JARVIS Runtime — Environment Variables Template
# Copy this file to .env and fill in values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
JARVIS_ENV=development

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Neo4j ─────────────────────────────────────────────────────────────────────
DATABASE_NEO4J_URI=bolt://localhost:7687
DATABASE_NEO4J_USER=neo4j
DATABASE_NEO4J_PASSWORD=your-neo4j-password
DATABASE_NEO4J_DATABASE=neo4j

# ── Milvus ────────────────────────────────────────────────────────────────────
DATABASE_MILVUS_URI=http://localhost:19530

# ── Auditing ─────────────────────────────────────────────────────────────
BIGQUERY_PROJECT=my-gcp-project
BIGQUERY_DATASET=jarvis_audits
BIGQUERY_TABLE=workflow_events
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
DATABASE_MILVUS_TOKEN=

# ── Redis (Future) ────────────────────────────────────────────────────────────
REDIS_URI=redis://localhost:6379
REDIS_PASSWORD=

# ── Telemetry (Future) ────────────────────────────────────────────────────────
TELEMETRY_OTLP_ENDPOINT=http://localhost:4317

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
